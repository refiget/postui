.mypy_cache/
.ruff_cache/

# The local API example is versioned; keep its generated data ignored.
!/example-api/**/*.py
!/example-api/**/requirements*.txt

# Local logs and runtime files
*.log
logs/
*.pid
/temp/
**/.postui/cache/

# Local API upload data
/example-api/test_files/
/example-api/temp/
/example-api/test-bin/

# Local environment variables
.env
.env.*
!.env.example

# User upload files
/test_files/*
!/test_files/PLACE_UPLOAD_FILES_HERE.txt

# Local project and user configuration
/config.yaml
/.postui/
/themes/

